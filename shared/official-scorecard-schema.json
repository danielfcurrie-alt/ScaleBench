{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalebench.app/schemas/official-scorecard-schema.json",
  "title": "ScaleBench Official Scorecard Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appName",
    "scoringModelVersion",
    "scoringProfileName",
    "recordingId",
    "generatedAtMillis",
    "platform",
    "mode",
    "protocolKind",
    "deviceName",
    "scoreTitle",
    "score",
    "scoreIsUpperBound",
    "valid",
    "validityReasons",
    "longGapCount",
    "missingSequenceCount",
    "rejectedPacketCount",
    "sampleCount",
    "rawPacketCount",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appName": { "type": "string" },
    "scoringModelVersion": { "type": "string" },
    "scoringProfileName": { "type": "string" },
    "recordingId": { "type": "string", "format": "uuid" },
    "generatedAtMillis": { "type": "integer" },
    "platform": { "type": "string" },
    "mode": { "$ref": "recording-schema.json#/$defs/recordingMode" },
    "protocolKind": { "$ref": "recording-schema.json#/$defs/scaleKind" },
    "deviceName": { "type": "string" },
    "scoreTitle": { "type": "string" },
    "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "scoreIsUpperBound": { "type": "boolean" },
    "valid": { "type": "boolean" },
    "validityReasons": { "type": "array", "items": { "type": "string" } },
    "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "purity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "verificationCoveragePercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "sampleRateHz": { "type": ["number", "null"] },
    "deviceCadenceHz": { "type": ["number", "null"], "minimum": 0 },
    "receivedSampleRateHz": { "type": ["number", "null"], "minimum": 0 },
    "p95IntervalMilliseconds": { "type": ["number", "null"] },
    "maxGapMilliseconds": { "type": ["number", "null"] },
    "longGapCount": { "type": "integer" },
    "missingSequenceCount": { "type": "integer" },
    "rejectedPacketCount": { "type": "integer" },
    "sampleCount": { "type": "integer" },
    "rawPacketCount": { "type": "integer" },
    "notes": { "type": "string" }
  }
}
